# AutoEpiBot .gitignore
# Exclude data files and logs while keeping code and syndrome sheets

# R Data files
*.RData
*.rdata
.RData
.Rhistory

# CSV files (except in SyndromeSheets folder)
*.csv
!SyndromeSheets/*.csv

# Log files and temporary data
TestLogs/
LogsFileLoc.RData
InvestigateTSRecords.RData
EmailStarterInfo.RData
reportsData.RData

# Settings and configuration (sensitive data)
AutoEpi_Settings.RData
AutoEpi_last_settings_path.txt

# R temporary files
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# IDE files
.vscode/
*.Rproj.user

# OS files
.DS_Store
Thumbs.db

# Output directories (will be created at runtime)
Reports/
Logs/

# Temporary test files
test_*.R
wireframe.txt

# Data layers (large files)
ZipLayer/

# Documentation (keep local only)
Documentation/
